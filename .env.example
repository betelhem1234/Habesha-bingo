# Telegram bot token from @BotFather
BOT_TOKEN=CHANGE_ME

# PostgreSQL connection string (created by deploy/setup-vm.sh)
# username/password/db set in that script: bingo / CHANGE_ME_STRONG_PASSWORD / bingo_db
DATABASE_URL=postgresql://bingo:CHANGE_ME_STRONG_PASSWORD@localhost:5432/bingo_db

# Your Telegram user id (admin) — get it from @userinfobot
ADMIN_USER_ID=CHANGE_ME

# Public tunnel URL — set AFTER starting cloudflared, e.g. https://xxx.trycloudflare.com
BINGO_APP_URL=https://CHANGE_ME.trycloudflare.com

# Telebirr payment credentials (placeholders)
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
